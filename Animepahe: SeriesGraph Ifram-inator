window.addEventListener("load",async function() {
    'use strict';

    const par = document.querySelectorAll(".anime-content")[0];
    if(!par){
        console.log("Parent query selector is broken.");
        return;
    }

    const heading = document.querySelectorAll(".title-wrapper span")[0]
    if(!heading){
        console.log("Heading query selector is broken.");
        return;
    }

    const title = animeUtils.cleanTitle(heading.innerText);
    const block = await seriesGraph.generateIframe(title);

    const div = document.createElement("div");
    div.style.maxWidth = "800px";
    div.style.margin = "0 auto 10px";
    div.appendChild(block);

    par.insertAdjacentElement("afterEnd",div);
    seriesGraph.addStyles();
});
